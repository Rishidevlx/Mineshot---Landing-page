{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/plugins/(.*)",
      "dest": "/plugins/$1"
    },
    {
      "src": "/Portfolio/(.*)",
      "dest": "/Portfolio/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/assets/img/mineshot/mineshot-icon.png"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
