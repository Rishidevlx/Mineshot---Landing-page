{
  "version": 2,
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.6.0"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/plugins/(.*)",
      "dest": "/plugins/$1"
    },
    {
      "src": "/Portfolio/(.*)",
      "dest": "/Portfolio/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/assets/img/mineshot/mineshot-icon.png"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
